#  ◈ SETTINGS (AUTOGENERATED FROM SETTINGS.JSON)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

general {
    border_size = 2
    gaps_in = 4
    gaps_out = 4
    float_gaps = 6
    resize_on_border = true
    extend_border_grab_area = 30
    col.active_border = $active_border1 $active_border2 $active_border3 135deg
    col.inactive_border=$inactive_border 

    layout=monocle
    
    # Set the Spotify and Discord special workspace to use the dwindle layout
    workspace=special:spotify_discord,layout:dwindle
}


scrolling {
    column_width = 0.8
    fullscreen_on_one_column = true

    follow_focus = true
    focus_fit_method = 1
}

# See https://wiki.hypr.land/Configuring/Dwindle-Layout/ for more
dwindle {
    preserve_split = true
}

# See https://wiki.hypr.land/Configuring/Master-Layout/ for more
master {
    new_status = master
}


decoration {
    rounding = 8
    rounding_power = 2

    active_opacity = 1.0
    inactive_opacity = 0.85
    
    blur {
        enabled = true
        size = 3
        passes = 3

        vibrancy = 0.1696

        new_optimizations = true
    }
    shadow {
        enabled = true
        range = 8
        render_power = 3
        color = rgba(1a1a1aee)
    }
}

input {
    kb_layout = {{KB_LAYOUT}}
    kb_options = {{KB_OPTIONS}}

    numlock_by_default = true

    follow_mouse = 2

    # Disable mouse acceleration
    accel_profile = flat

    touchpad {
        natural_scroll = false
    }
}

cursor {
    no_warps = true
}

misc {
    font_family = SF Pro
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
}

ecosystem {
    no_update_news = false
    no_donation_nag = true
}

animations {
    enabled = yes

    # Default curves, see https://wiki.hypr.land/Configuring/Animations/#curves
    #        NAME,           X0,   Y0,   X1,   Y1

    bezier = easeOutQuint,   0.23, 1,    0.32, 1
    bezier = easeInOutCubic, 0.65, 0.05, 0.36, 1
    bezier = linear,         0,    0,    1,    1
    bezier = almostLinear,   0.5,  0.5,  0.75, 1
    bezier = quick,          0.15, 0,    0.1,  1
    bezier = myBezier, 0.05, 0.9, 0.1, 1.05

    animation = windows, 1, 5, easeOutQuint, popin 80%
    animation = windowsOut, 1, 5, linear, popin 80%
    animation = layers, 1, 5, easeOutQuint, fade
    animation = layersIn, 1, 5, easeOutQuint, fade
    animation = layersOut, 1, 5, linear, fade
    animation = fade, 1, 5, quick
    animation = workspaces, 1, 5, easeOutQuint, slide
    animation = specialWorkspaceIn, 1, 5, easeOutQuint, fade
    animation = specialWorkspaceOut, 1, 5, easeOutQuint, fade
}
