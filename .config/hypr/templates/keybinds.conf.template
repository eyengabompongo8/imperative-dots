# ───────── Static Core Binds ─────────
bindm = SUPER, mouse:272, movewindow
bindm = SUPER, mouse:273, resizewindow

gesture = 3, right, dispatcher, exec, ~/.config/hypr/scripts/window_cycle.sh
gesture = 3, left, dispatcher, exec, ~/.config/hypr/scripts/window_cycle.sh prev

gesture = 4, horizontal, workspace
gesture = 4, up, special, monitoring
gesture = 4, down, special, spotify_discord

gesture = 3, pinchin, float, tile
gesture = 3, pinchout, float, float

gesture = 4, pinch, fullscreen

