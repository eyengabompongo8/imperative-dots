-- ───────── Static Core Binds ─────────
hl.bind("SUPER + mouse:272", hl.dsp.window.drag(), { mouse = true })
hl.bind("SUPER + mouse:273", hl.dsp.window.resize(), { mouse = true })
hl.bind("SUPER + SHIFT + mouse:272", hl.dsp.window.resize(), { mouse = true })

local home = os.getenv("HOME")
hl.gesture({ fingers = 3, direction = "right", action = function() hl.exec_cmd(home .. "/.config/hypr/scripts/window_cycle.sh") end })
hl.gesture({ fingers = 3, direction = "left", action = function() hl.exec_cmd("/home/eyenga/.config/hypr/scripts/window_cycle.sh prev") end })

hl.gesture({ fingers = 4, direction = "horizontal", action = "workspace" })
hl.gesture({ fingers = 4, direction = "up", action = function() hl.exec_cmd(home .. "/.config/hypr/scripts/special_workspaces.sh move up") end })
hl.gesture({ fingers = 4, direction = "down", action = function() hl.exec_cmd(home .. "/.config/hypr/scripts/special_workspaces.sh move down") end })

hl.gesture({ fingers = 3, direction = "pinchin", action = "float" })
hl.gesture({ fingers = 3, direction = "pinchout", action = "float" })

hl.gesture({ fingers = 4, direction = "pinch", action = "fullscreen" })

-- ───────── Lid ─────────
hl.bind("switch:off:Lid Switch", hl.dsp.dpms({ action = "enable" }), { locked = true })
hl.bind("switch:on:Lid Switch", hl.dsp.dpms({ action = "disable" }), { locked = true })

